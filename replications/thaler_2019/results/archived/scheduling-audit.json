  "findings": [
    {
      "variant": "seq",
      "finding": "Init adds environment behavior as ID0 to agent list. Simulation shuffles complete behavior list each step and executes it sequentially. Regrowth therefore occurs at its shuffled position, not necessarily after population."
    },
    {
      "variant": "io,tvar,tarray",
      "finding": "Main sets envConc=False. Simulation waits for all agent outputs before stepping the separate environment behavior."
    },
    {
      "variant": "seq",
      "finding": "chapterII subtracts metabolism and removes starved agents before movement/harvest. Surviving agents then emit observables; the environment emits none. Population exporter length counts living agents, excluding environment."
    },
    {
      "variant": "seq",
      "finding": "simulationStep returns the pre-increment clock paired with post-step outputs. The 1000-row exporter therefore labels processed steps0..999; do not prepend an initial-state row."
    }
  ],
  "consequence": "Preserve released model for Figure5 replay. Do not claim all variants share the same environment schedule. Compare dynamics before attributing timing differences solely to synchronization. No negative replication verdict."
