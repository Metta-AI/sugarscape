+-- Observation only: serialize the existing immutable simulation outputs.
+writeState :: SimStepOut -> IO ()
+writeState (t, env, agents) = do
+    let suffix = show (round t :: Int) ++ ".csv"
+        agentRows = [printf "%d,%d,%d,%d" aid x y (sugObsVision observable)
+                    | (aid, observable) <- agents, let (x, y) = sugObsCoord observable]
+        cellRows = [printf "%d,%d,%.17g,%.17g,%d" x y (sugEnvSugarLevel cell)
+                      (sugEnvSugarCapacity cell) (maybe (-1) sugEnvOccId (sugEnvOccupier cell))
+                   | ((x, y), cell) <- allCellsWithCoords env]
+    writeFile ("agents-" ++ suffix) (unlines ("id,x,y,vision" : agentRows))
+    writeFile ("cells-" ++ suffix) (unlines ("x,y,sugar,capacity,occupier" : cellRows))
