

to-report observed-agent-sugar
  let observation 0
  with-local-randomness [ set observation sum [sugar] of agents ]
  report observation
end

to-report observed-agent-spice
  let observation 0
  with-local-randomness [ set observation sum [spice] of agents ]
  report observation
end

to-report observed-site-sugar
  let observation 0
  with-local-randomness [ set observation sum [psugar] of patches ]
  report observation
end

to-report observed-site-spice
  let observation 0
  with-local-randomness [ set observation sum [pspice] of patches ]
  report observation
end

to-report observed-agent-states
  let observation 0
  with-local-randomness [ set observation [(list who xcor ycor age sugar spice sugarMetabolism spiceMetabolism vision)] of agents ]
  report observation
end
